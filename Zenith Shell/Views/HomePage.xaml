<Page
    x:Class="Zenith_Shell.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:models="using:Zenith_Shell.Models"
    xmlns:vm="using:Zenith_Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.DataContext>
        <vm:HomeViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <ScrollViewer Padding="32,24,32,32">
        <Grid RowSpacing="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SECCIÓN SUPERIOR: Carrusel + Tarjetas Laterales -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <!-- Carrusel (más ancho) -->
                    <ColumnDefinition Width="1*"/>
                    <!-- Tarjetas (más angostas) -->
                </Grid.ColumnDefinitions>

                <!-- StoreCarousel (Izquierda) -->
                <dev:StoreCarousel Grid.Column="0"
                                   AutoShuffle="True"
                                   PrimaryImageSource="https://picsum.photos/seed/side1/400/200"
                                   SecondaryImageSource="https://picsum.photos/seed/side2/400/200"
                                   TertiaryImageSource="https://picsum.photos/seed/side3/400/200"
                                   ItemsSource="{x:Bind ViewModel.CarouselItems, Mode=OneWay}" />

                <!-- Grid de Tarjetas (Derecha) -->
                <Grid Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Grande (Ej: Microsoft 365) -->
                    <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Image Source="{x:Bind ViewModel.SidebarTopItems[0].ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                            <TextBlock Text="{x:Bind ViewModel.SidebarTopItems[0].Title, Mode=OneWay}" 
                                       VerticalAlignment="Bottom" Margin="16" 
                                       FontSize="20" FontWeight="SemiBold" Foreground="White" 
                                       TextShadow="0,1,2,Black"/>
                        </Grid>
                    </Border>

                    <!-- Cards Pequeñas (Ej: Minecraft, WhatsApp) -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.SidebarBottomItems[0].ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                <TextBlock Text="{x:Bind ViewModel.SidebarBottomItems[0].Title, Mode=OneWay}" VerticalAlignment="Bottom" Margin="12" FontWeight="SemiBold" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.SidebarBottomItems[1].ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                <TextBlock Text="{x:Bind ViewModel.SidebarBottomItems[1].Title, Mode=OneWay}" VerticalAlignment="Bottom" Margin="12" FontWeight="SemiBold" Foreground="White"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- SECCIÓN INFERIOR: Tendencias -->
            <Grid Grid.Row="1" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Trending Games -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Trending games" FontSize="20" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{x:Bind ViewModel.TrendingGames, Mode=OneWay}" 
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HomeCardItem">
                                <Grid Width="180" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icono del juego -->
                                    <Border Width="48" Height="48" CornerRadius="8" Background="Gray" Margin="0,0,12,0">
                                        <Image Source="{x:Bind ImageSource}"/>
                                    </Border>
                                    <!-- Textos -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Trending Apps -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Text="Trending apps" FontSize="20" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{x:Bind ViewModel.TrendingApps, Mode=OneWay}" 
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HomeCardItem">
                                <Grid Width="180" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="8" Background="Gray" Margin="0,0,12,0">
                                        <Image Source="{x:Bind ImageSource}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>