<Page
    x:Class="Zenith_Shell.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI"
    xmlns:models="using:Zenith_Shell.Models"
    xmlns:vm="using:Zenith_Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.DataContext>
        <vm:HomeViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <ScrollViewer Padding="32,24,32,32">
        <Grid RowSpacing="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SECCIÓN SUPERIOR -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- StoreCarousel -->
                <dev:StoreCarousel Grid.Column="0"
                                   AutoShuffle="True"
                                   PrimaryImageSource="https://picsum.photos/seed/side1/400/200"
                                   SecondaryImageSource="https://picsum.photos/seed/side2/400/200"
                                   TertiaryImageSource="https://picsum.photos/seed/side3/400/200"
                                   ItemsSource="{x:Bind ViewModel.CarouselItems, Mode=OneWay}" />

                <!-- Grid de Tarjetas (Derecha) -->
                <Grid Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Grande (Top) -->
                    <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Image Source="{x:Bind ViewModel.SidebarTopItem.ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                            <Border VerticalAlignment="Bottom" Background="#80000000" CornerRadius="8,8,0,0" Padding="16,8">
                                <TextBlock Text="{x:Bind ViewModel.SidebarTopItem.Title, Mode=OneWay}" 
                                           FontSize="20" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cards Pequeñas (Bottom) -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.SidebarBottomItem1.ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#80000000" CornerRadius="8,8,0,0" Padding="12,6">
                                    <TextBlock Text="{x:Bind ViewModel.SidebarBottomItem1.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.SidebarBottomItem2.ImageSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#80000000" CornerRadius="8,8,0,0" Padding="12,6">
                                    <TextBlock Text="{x:Bind ViewModel.SidebarBottomItem2.Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- SECCIÓN INFERIOR: Tendencias (Se mantiene igual) -->
            <!-- ... -->
        </Grid>
    </ScrollViewer>
</Page>