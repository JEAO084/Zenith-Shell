<Window
    x:Class="Zenith_Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Zenith_Shell.Models"
    Title="Zenith Shell">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox
            Grid.Row="0"
            PlaceholderText="Buscar apps..."
            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:AppEntry">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>