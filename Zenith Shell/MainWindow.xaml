<Window
    x:Class="Zenith_Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="MainNav" 
                        PaneDisplayMode="LeftCompact" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="MainNav_SelectionChanged">

            <!-- Los elementos del menú lateral -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem Content="Apps" Tag="Apps" Icon="AllApps" />
                <NavigationViewItem Content="Gaming" Tag="Gaming" Icon="Game" />
            </NavigationView.MenuItems>

            <!-- El Frame es donde se cargan las páginas (HomePage, etc.) -->
            <Frame x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>