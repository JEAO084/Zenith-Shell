<Window
    x:Class="Zenith_Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Zenith_Shell.Models"
    Title="Zenith Shell">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <!-- Menú lateral tipo Store -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Aquí iría tu NavigationView o menú personalizado -->
        <NavigationView x:Name="MainNav" Grid.Column="0" Grid.ColumnSpan="2" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" MenuItemsSource="{x:Bind ...}">
            <!-- Frame principal donde cargaremos HomePage -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>